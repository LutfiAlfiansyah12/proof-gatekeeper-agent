# ── Required ────────────────────────────────────────────────────────────────
# Platform HMAC secret. Dashboard → My Agents → "Rotate Secret".
# Revealed ONCE — paste it here, never in chat, never in git.
AGENT_GAMES_HMAC_SECRET=

# ── Server ──────────────────────────────────────────────────────────────────
# The platform requires a PUBLIC HTTPS endpoint. Either terminate TLS in a
# reverse proxy (nginx/caddy/cloudflare) in front of this process, or provide
# certs here to enable the built-in HTTPS listener.
PORT=8081
HOST=127.0.0.1
# Path the platform POSTs to — must match EXACTLY what you register (incl. case).
AGENT_PATH=/agent
# TLS_CERT_PATH=/etc/letsencrypt/live/yourdomain/fullchain.pem
# TLS_KEY_PATH=/etc/letsencrypt/live/yourdomain/privkey.pem

# ── Circuit ─────────────────────────────────────────────────────────────────
# The vk_hash registered on zkVerify for the gatekeeper condition (from
# https://agentgames.zkverify.io/api/circuit-info). Tasks whose registered_vk
# does not match are rejected as CIRCUIT_MISMATCH (checklist #1/#2).
EXPECTED_VK_HASH=0x6b79c6012a6d8651f3e13bc4d2a20370280ab49700c90c5316d4168bfbad77b0
ARTIFACTS_DIR=./artifacts

# How the string task_id ("gk_8d31_...") is mapped to a circuit field element.
# UNCONFIRMED — verify in practice mode, adjust if the platform documents it.
# keccak  = keccak256(utf8(task_id)) mod r   (default)
# digits  = decimal digits extracted from the string, interpreted as a number
# numeric = the task_id is already a decimal integer
# zero    = 0
TASKID_FIELD_MODE=keccak

# ── zkVerify / Kurier ───────────────────────────────────────────────────────
# Checklist #5: a verification must reach FINALIZED state before an APPROVE
# is returned. The agent submits via Kurier and polls until Finalized.
APPROVAL_REQUIRE_FINALIZED=true
KURIER_URL=https://api.kurier.xyz
KURIER_API_KEY=
# Polling budget (ms) for finalization — must fit inside the 60s task deadline.
KURIER_FINALIZE_TIMEOUT_MS=35000
KURIER_POLL_INTERVAL_MS=2000

# ── Behaviour ───────────────────────────────────────────────────────────────
# Hard response deadline the platform enforces (ms). The agent answers with a
# signed REJECT if processing exceeds it (fail closed).
TASK_DEADLINE_MS=60000
CLOCK_SKEW_SECONDS=300
LOG_LEVEL=info
# Path of the proof-reuse store (checklist #4). Keep on persistent disk.
REUSE_STORE_PATH=./data/seen-proof-tx.json
