# Caddyfile — reverse proxy HTTPS otomatis (Let's Encrypt) untuk DUA agent
# Letakkan di VPS: /etc/caddy/Caddyfile
#
#   /gatekeeper/* → 127.0.0.1:8081  (agent Proof Gatekeeper, systemd)
#   /vfy/*        → 127.0.0.1:8080  (agent Steal the VFY, docker)
#
# handle_path MEMBUANG prefix: POST /gatekeeper/agent sampai ke agent
# sebagai /agent — jadi AGENT_PATH=/agent di konfigurasi masing-masing agent.

0xmurasaki.duckdns.org {
	handle_path /gatekeeper/* {
		reverse_proxy 127.0.0.1:8081
	}

	handle_path /vfy/* {
		reverse_proxy 127.0.0.1:8080
	}

	# Health check gatekeeper langsung (opsional, tanpa prefix)
	handle /health {
		reverse_proxy 127.0.0.1:8081
	}

	handle {
		respond "not found" 404
	}
}
