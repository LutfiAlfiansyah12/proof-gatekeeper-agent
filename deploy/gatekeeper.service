# systemd unit — jalankan agent sebagai service + auto-restart
# Letakkan di VPS: /etc/systemd/system/gatekeeper.service
# Ganti /home/ubuntu/zkverify sesuai lokasi project.

[Unit]
Description=zkVerify Proof Gatekeeper Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/zkverify
ExecStartPre=/usr/bin/mkdir -p /root/zkverify/data
ExecStart=/usr/bin/node dist/src/main.js
Restart=always
RestartSec=3
EnvironmentFile=/root/zkverify/.env

NoNewPrivileges=true
PrivateTmp=true
ReadWritePaths=/root/zkverify/data

# Log ke journald — lihat dengan: journalctl -u gatekeeper -f
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
