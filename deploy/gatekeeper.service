# systemd unit — jalankan agent sebagai service + auto-restart
# Letakkan di VPS: /etc/systemd/system/gatekeeper.service
# Ganti /home/ubuntu/zkverify sesuai lokasi project.

[Unit]
Description=zkVerify Proof Gatekeeper Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/zkverify
ExecStart=/usr/bin/node dist/src/main.js
Restart=always
RestartSec=3
# Env file berisi AGENT_GAMES_HMAC_SECRET dll — permission ketat
EnvironmentFile=/home/ubuntu/zkverify/.env

# Hardening ringan
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/ubuntu/zkverify/data

# Log ke journald — lihat dengan: journalctl -u gatekeeper -f
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
